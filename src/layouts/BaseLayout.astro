---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
    title?: string;
    description?: string;
}

const {
    title = "REDNECK — Независимый авторский журнал",
    description = "Независимый авторский журнал о власти, людях и смыслах.",
} = Astro.props;
---

<!DOCTYPE html>

<html lang="ru">

<head>

    <meta charset="UTF-8" />

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    />

    <title>{title}</title>

    <meta
        name="description"
        content={description}
    />

    <link
        rel="icon"
        type="image/png"
        href="/favicon.png"
    />

</head>

<body>

    <Header />

    <main>

        <slot />

    </main>

    <Footer />

</body>

</html>