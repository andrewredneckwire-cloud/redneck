---
const { title } = Astro.props;

const pageUrl = Astro.url.href;

const encodedUrl = encodeURIComponent(pageUrl);
const encodedTitle = encodeURIComponent(title);
---

<div class="share-bar">

    <div class="share-bar-title">
        ПОДЕЛИТЬСЯ
    </div>

    <div class="share-bar-content">

        <div class="share-buttons">

            <!-- Facebook -->
            <a
                href={`https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`}
                target="_blank"
                rel="noopener noreferrer"
                class="share-button"
                aria-label="Поделиться в Facebook"
                title="Facebook"
            >
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path
                        fill="currentColor"
                        d="M14 8h3V4h-3c-2.8 0-5 2.2-5 5v3H6v4h3v8h4v-8h3l1-4h-4V9c0-.6.4-1 1-1Z"
                    />
                </svg>
            </a>


            <!-- Telegram -->
            <a
                href={`https://t.me/share/url?url=${encodedUrl}&text=${encodedTitle}`}
                target="_blank"
                rel="noopener noreferrer"
                class="share-button"
                aria-label="Поделиться в Telegram"
                title="Telegram"
            >
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path
                        fill="currentColor"
                        d="M21.4 4.6 18.3 19c-.2 1-.8 1.3-1.6.8l-4.4-3.3-2.1 2c-.2.2-.4.4-.8.4l.3-4.5 8.2-7.4c.4-.4-.1-.6-.6-.2L7.2 13.2l-4.3-1.4c-.9-.3-.9-.9.2-1.3L20.5 4c.8-.3 1.3.1.9.6Z"
                    />
                </svg>
            </a>


            <!-- X -->
            <a
                href={`https://twitter.com/intent/tweet?url=${encodedUrl}&text=${encodedTitle}`}
                target="_blank"
                rel="noopener noreferrer"
                class="share-button"
                aria-label="Поделиться в X"
                title="X"
            >
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path
                        fill="currentColor"
                        d="M18.2 2h3.6l-7.8 8.9L23 22h-7.1l-5.5-7.2L4.1 22H.5l8.4-9.6L1 2h7.3l5 6.6L18.2 2Zm-1.2 17.5h2L7.1 4.3H5l12 15.2Z"
                    />
                </svg>
            </a>


            <!-- Threads -->
            <a
                href={`https://www.threads.net/intent/post?text=${encodedTitle}%20${encodedUrl}`}
                target="_blank"
                rel="noopener noreferrer"
                class="share-button"
                aria-label="Поделиться в Threads"
                title="Threads"
            >
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.8"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M12 4.5c-4.4 0-7 2.7-7 7.5s2.6 7.5 7 7.5c4 0 6.5-2.1 6.5-5.3 0-3-2.1-4.8-5.4-4.8-2.5 0-4.2 1.2-4.2 3.1 0 1.7 1.5 2.8 3.7 2.8 2.8 0 4.7-1.6 4.7-4.4C17.3 7.2 15.2 4.5 12 4.5Z"
                    />
                    <circle
                        cx="12"
                        cy="13.1"
                        r="1.2"
                        fill="currentColor"
                    />
                </svg>
            </a>


            <!-- Bluesky -->
            <a
                href={`https://bsky.app/intent/compose?text=${encodedTitle}%20${encodedUrl}`}
                target="_blank"
                rel="noopener noreferrer"
                class="share-button"
                aria-label="Поделиться в Bluesky"
                title="Bluesky"
            >
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path
                        fill="currentColor"
                        d="M12 11.1C10.8 8.8 8.2 5.4 5.3 4.1 2.9 3 2.2 3.5 2.2 4.8c0 .3.2 2.4.4 3.1.5 2.1 2.1 3.5 4.5 4.1-2.2-.2-4.1.3-4.7 1.5-.7 1.4.6 3.4 2.8 4.4 2 .9 3.8.4 5-1.1-.1 2.1.2 3.8 1.8 3.8s1.9-1.7 1.8-3.8c1.2 1.5 3 2 5 1.1 2.2-1 3.5-3 2.8-4.4-.6-1.2-2.5-1.7-4.7-1.5 2.4-.6 4-2 4.5-4.1.2-.7.4-2.8.4-3.1 0-1.3-.7-1.8-3.1-.7-2.9 1.3-5.5 4.7-6.7 7Z"
                    />
                </svg>
            </a>

        </div>


        <a
           href="mailto:andrewredneckwire@gmail.com?subject=REDNECK — Связаться с редакцией"
            class="contact-editor"
        >
            СВЯЗАТЬСЯ С РЕДАКЦИЕЙ →
        </a>

    </div>

</div>